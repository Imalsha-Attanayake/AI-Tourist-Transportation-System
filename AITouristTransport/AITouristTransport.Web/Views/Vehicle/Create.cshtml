@model AITouristTransport.Web.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Add New Vehicle
                    </h2>

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="VehicleName"
                                   class="form-label">
                                Vehicle Name
                            </label>

                            <input asp-for="VehicleName"
                                   class="form-control"
                                   placeholder="e.g. Toyota Prius" />

                            <span asp-validation-for="VehicleName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VehicleType"
                                   class="form-label">
                                Vehicle Type
                            </label>

                            <input asp-for="VehicleType"
                                   class="form-control"
                                   placeholder="e.g. Car, Van, Mini Bus" />

                            <span asp-validation-for="VehicleType"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SeatCapacity"
                                   class="form-label">
                                Seat Capacity
                            </label>

                            <input asp-for="SeatCapacity"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   placeholder="e.g. 4" />

                            <span asp-validation-for="SeatCapacity"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PricePerDay"
                                   class="form-label">
                                Price Per Day
                            </label>

                            <input asp-for="PricePerDay"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="e.g. 8500" />

                            <span asp-validation-for="PricePerDay"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Vehicle Picture
                            </label>

                            <input type="file"
                                   name="vehicleImage"
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">
                                Upload a JPG, JPEG, PNG or other image file.
                            </small>
                        </div>

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Vehicle
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}