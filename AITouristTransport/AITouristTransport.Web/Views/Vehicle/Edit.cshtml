@model AITouristTransport.Web.Models.Vehicle

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h2 class="mb-4">Edit Vehicle</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="VehicleId" />

    <div class="mb-3">
        <label asp-for="VehicleName" class="form-label"></label>
        <input asp-for="VehicleName" class="form-control" />
        <span asp-validation-for="VehicleName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VehicleType" class="form-label"></label>
        <input asp-for="VehicleType" class="form-control" />
        <span asp-validation-for="VehicleType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SeatCapacity" class="form-label"></label>
        <input asp-for="SeatCapacity" class="form-control" />
        <span asp-validation-for="SeatCapacity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PricePerDay" class="form-label"></label>
        <input asp-for="PricePerDay" class="form-control" />
        <span asp-validation-for="PricePerDay" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Update Vehicle
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}