@model AITouristTransport.Web.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2 class="text-danger">Delete Vehicle</h2>

<div class="alert alert-warning">
    <h5>Are you sure you want to delete this vehicle?</h5>
</div>

<table class="table table-bordered">

    <tr>
        <th>Vehicle Name</th>
        <td>@Model.VehicleName</td>
    </tr>

    <tr>
        <th>Vehicle Type</th>
        <td>@Model.VehicleType</td>
    </tr>

    <tr>
        <th>Seat Capacity</th>
        <td>@Model.SeatCapacity</td>
    </tr>

    <tr>
        <th>Price Per Day</th>
        <td>@Model.PricePerDay</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="VehicleId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>