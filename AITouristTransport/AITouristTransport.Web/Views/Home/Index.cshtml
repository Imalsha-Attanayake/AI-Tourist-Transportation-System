                    <div class="feature-icon">
                        🤖
                    </div>

                    <h5>
                        AI Vehicle Recommendation
                    </h5>

                    <p>
                        Get personalized vehicle suggestions
                        based on your travel requirements.
                    </p>

                </div>

            </div>



            <div class="col-md-6 col-lg-3">

                <div class="feature-card text-center">

                    <div class="feature-icon">
                        💰
                    </div>

                    <h5>
                        Budget Estimation
                    </h5>

                    <p>
                        Predict your travel expenses before
