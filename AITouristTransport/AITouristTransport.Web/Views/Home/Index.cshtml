</section>

<!-- Popular Destinations Section -->

<section class="destinations-section py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Popular Destinations in Sri Lanka
            </h2>

            <p class="text-muted">
                Discover beautiful places with AI-powered travel planning.
            </p>

        </div>


        <div class="row g-4">


            <div class="col-md-6 col-lg-3">

                <div class="destination-card">

                    <div class="destination-image">
                        <img src="~/images/destinations/ella.png"
                             alt="Ella"
                             class="img-fluid w-100"
                             style="height: 200px; object-fit: cover;" />
                    </div>

                    <div class="p-3">

                        <h5>
                            Ella
                        </h5>

                        <p>
                            Mountains, waterfalls and scenic train journeys.
                        </p>

                    </div>

                </div>

            </div>



            <div class="col-md-6 col-lg-3">

                <div class="destination-card">

                    <div class="destination-image">
                        <img src="~/images/destinations/kandy.png"
                             alt="Kandy"
                             class="img-fluid w-100"
                             style="height: 200px; object-fit: cover;" />
                    </div>

                    <div class="p-3">

                        <h5>
                            Kandy
                        </h5>

                        <p>
                            Cultural capital with historic attractions.
                        </p>

                    </div>

                </div>

            </div>



            <div class="col-md-6 col-lg-3">

                <div class="destination-card">

                    <div class="destination-image">
                        <img src="~/images/destinations/mirissa.jpg"
                             alt="Mirissa"
                             class="img-fluid w-100"
                             style="height: 200px; object-fit: cover;" />
                    </div>

                    <div class="p-3">

                        <h5>
                            Mirissa
                        </h5>

                        <p>
                            Beautiful beaches and ocean experiences.
                        </p>

                    </div>

                </div>

            </div>



            <div class="col-md-6 col-lg-3">

                <div class="destination-card">

                    <div class="destination-image">
                        <img src="~/images/destinations/sigiriya.png"
                             alt="Sigiriya"
                             class="img-fluid w-100"
                             style="height: 200px; object-fit: cover;" />
                    </div>

                    <div class="p-3">

                        <h5>
                            Sigiriya
                        </h5>

                        <p>
                            Ancient rock fortress and heritage site.
                        </p>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>