@model AITouristTransport.Web.Models.VehicleProvider?

@{
    ViewData["Title"] = "Vehicle Provider Dashboard";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2>Vehicle Provider Dashboard</h2>

        <p class="text-muted">
            Manage your vehicle provider account and vehicles.
        </p>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-info">
            <h5>Provider Profile Not Found</h5>

            <p class="mb-3">
                Your account is registered as a Vehicle Provider,
                but your provider profile has not been created yet.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Create Provider Profile
            </a>
        </div>
    }
    else
    {
        <!-- Provider Profile -->

        <div class="card shadow mb-4">

            <div class="card-body">

                <h4>@Model.CompanyName</h4>

                <hr />

                <p>
                    <strong>Provider ID:</strong>
                    @Model.ProviderId
                </p>

                <p>
                    <strong>Company Name:</strong>
                    @Model.CompanyName
                </p>

                <p>
                    <strong>Business Registration Number:</strong>
                    @Model.BusinessRegistrationNumber
                </p>

                <p>
                    <strong>Account Email:</strong>
                    @Model.User.Email
                </p>

            </div>

        </div>


       
        <!-- My Vehicles -->

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h3>
                My Vehicles
            </h3>

            <div class="d-flex gap-2">

                <a asp-controller="VehicleProvider"
                   asp-action="Bookings"
                   class="btn btn-primary">
                    📋 Manage Bookings
                </a>

                <a asp-controller="Vehicle"
                   asp-action="Create"
                   class="btn btn-success">
                    + Add Vehicle
                </a>

            </div>

        </div>


        @if (ViewBag.MyVehicles == null ||
            !((IEnumerable<AITouristTransport.Web.Models.Vehicle>)ViewBag.MyVehicles).Any())
        {
            <div class="alert alert-info">
                You have not added any vehicles yet.
            </div>
        }
        else
        {
            <div class="row">

                @foreach (var vehicle in
                        (IEnumerable<AITouristTransport.Web.Models.Vehicle>)ViewBag.MyVehicles)
                {
                    <div class="col-md-4 mb-4">

                        <div class="card shadow h-100">

                            @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                            {
                                <img src="@vehicle.ImageUrl"
                                     class="card-img-top"
                                     alt="@vehicle.VehicleName"
                                     style="height:200px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light"
                                     style="height:200px;">
                                    <span class="text-muted">
                                        No image available
                                    </span>
                                </div>
                            }

                            <div class="card-body">

                                <h5 class="card-title">
                                    @vehicle.VehicleName
                                </h5>

                                <p class="card-text">

                                    <strong>Type:</strong>
                                    @vehicle.VehicleType
                                    <br />

                                    <strong>Seats:</strong>
                                    @vehicle.SeatCapacity
                                    <br />

                                    <strong>Price:</strong>
                                    Rs. @vehicle.PricePerDay.ToString("N2")
                                    / day

                                </p>

                                <div class="d-flex gap-2">

                                    <a asp-controller="Vehicle"
                                       asp-action="Edit"
                                       asp-route-id="@vehicle.VehicleId"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-controller="Vehicle"
                                       asp-action="Delete"
                                       asp-route-id="@vehicle.VehicleId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    }

</div>