@using AITouristTransport.Web.Models

@{
    ViewData["Title"] = "Book Vehicle";
    var vehicle = ViewBag.Vehicle as Vehicle;
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Book Your Vehicle</h1>
        <p class="text-muted">
            Complete the booking details for your selected vehicle.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    @if (vehicle != null)
                    {
                        <div class="alert alert-primary mb-4">

                            <h5 class="mb-2">
                                🚗 Selected Vehicle
                            </h5>

                            <strong>
                                @vehicle.VehicleName
                            </strong>

                            <br />

                            <span>
                                Type: @vehicle.VehicleType
                            </span>

                            <br />

                            <span>
                                Seats: @vehicle.SeatCapacity
                            </span>

                            <br />

                            <span>
                                Price per day: LKR @vehicle.PricePerDay.ToString("N2")
                            </span>

                        </div>
                    }

                    <form asp-action="Create"
                          asp-controller="Booking"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="VehicleId"
                               value="@vehicle?.VehicleId" />

                        <div class="mb-3">

                            <label class="form-label">
                                Starting Location
                            </label>

                            <select class="form-select"
                                    name="StartLocation"
                                    required>

                                <option value="">
                                    Select Starting Location
                                </option>

                                <option value="Colombo">Colombo</option>
                                <option value="Kandy">Kandy</option>
                                <option value="Galle">Galle</option>
                                <option value="Negombo">Negombo</option>
                                <option value="Nuwara Eliya">Nuwara Eliya</option>
                                <option value="Sigiriya">Sigiriya</option>
                                <option value="Ella">Ella</option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Destination
                            </label>

                            <select class="form-select"
                                    name="Destination"
                                    required>

                                <option value="">
                                    Select Destination
                                </option>

                                <option value="Colombo">Colombo</option>
                                <option value="Kandy">Kandy</option>
                                <option value="Galle">Galle</option>
                                <option value="Negombo">Negombo</option>
                                <option value="Nuwara Eliya">
                                    Nuwara Eliya
                                </option>
                                <option value="Sigiriya">Sigiriya</option>
                                <option value="Ella">Ella</option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Travel Date
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="TravelDate"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Travel Duration (Days)
                            </label>

                            <input type="number"
                                   class="form-control"
                                   name="TravelDurationDays"
                                   min="1"
                                   max="30"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Number of Travellers
                            </label>

                            <input type="number"
                                   class="form-control"
                                   name="Travellers"
                                   min="1"
                                   max="50"
                                   required />

                        </div>


                        <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                Confirm Booking

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>