@model IEnumerable<AITouristTransport.Web.Models.Booking>

@{
    ViewData["Title"] = "Booking History";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            My Booking History
        </h1>

        <p class="text-muted">
            View your previous and current vehicle bookings.
        </p>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var booking in Model)
            {
                <div class="col-lg-6">

                    <div class="card shadow border-0 h-100">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h5 class="fw-bold">
                                    Booking #@booking.BookingId
                                </h5>

                                @if (booking.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (booking.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @booking.Status
                                    </span>
                                }

                            </div>


                            <hr />


                            <div class="mb-3">

                                <strong>Vehicle:</strong>

                                @if (booking.Vehicle != null)
                                {
                                    @booking.Vehicle.VehicleName
                                }

                            </div>


                            <div class="mb-3">

                                <strong>Route:</strong>

                                @booking.StartLocation
                                →
                                @booking.Destination

                            </div>


                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <strong>Travel Date:</strong>

                                    <br />

                                    @booking.TravelDate.ToString("dd MMMM yyyy")

                                </div>


                                <div class="col-md-6 mb-3">

                                    <strong>Duration:</strong>

                                    <br />

                                    @booking.TravelDurationDays days

                                </div>


                                <div class="col-md-6 mb-3">

                                    <strong>Travellers:</strong>

                                    <br />

                                    @booking.Travellers

                                </div>


                                <div class="col-md-6 mb-3">

                                    <strong>Total Amount:</strong>

                                    <br />

                                    LKR @booking.TotalAmount.ToString("N2")

                                </div>

                            </div>


                            <small class="text-muted">

                                Booked on
                                @booking.CreatedAt.ToString("dd MMMM yyyy")

                            </small>

                            @{
                                var reviewedBookingIds =
                                ViewBag.ReviewedBookingIds as HashSet<int>
                                ?? new HashSet<int>();
                            }

                            @if (booking.Status == "Approved")
                            {
                                <div class="mt-3">

                                    @if (reviewedBookingIds.Contains(booking.BookingId))
                                    {
                                        <span class="btn btn-success disabled">
                                            ✅ Reviewed
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Review"
                                           asp-action="Create"
                                           asp-route-bookingId="@booking.BookingId"
                                           class="btn btn-primary">

                                            ⭐ Leave Review

                                        </a>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div style="font-size: 50px;">
                        📋
                    </div>

                    <h4 class="mt-3">
                        No Bookings Yet
                    </h4>

                    <p class="text-muted">
                        You have not made any vehicle bookings yet.
                    </p>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="btn btn-primary">

                        Browse Vehicles

                    </a>

                </div>

            </div>

        </div>
    }

</div>