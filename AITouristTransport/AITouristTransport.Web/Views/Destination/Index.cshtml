@{
    ViewData["Title"] = "Destinations";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Explore Sri Lanka</h1>
        <p class="text-muted">
            Discover amazing destinations across Sri Lanka.
        </p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="~/images/destinations/ella.png" class="card-img-top" alt="Ella">
                <div class="card-body">
                    <h5 class="card-title">Ella</h5>
                    <p class="card-text">
                        Experience breathtaking mountain views and the famous Nine Arches Bridge.
                    </p>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="~/images/destinations/kandy.png" class="card-img-top" alt="Kandy">
                <div class="card-body">
                    <h5 class="card-title">Kandy</h5>
                    <p class="card-text">
                        Visit the Temple of the Sacred Tooth Relic and enjoy the cultural heritage.
                    </p>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="~/images/destinations/sigiriya.png" class="card-img-top" alt="Sigiriya">
                <div class="card-body">
                    <h5 class="card-title">Sigiriya</h5>
                    <p class="card-text">
                        Explore the iconic Lion Rock, one of Sri Lanka's UNESCO World Heritage Sites.
                    </p>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

    </div>

</div>